{
  // Static hosting for the WhisperAI landing page.
  // No Worker script — Cloudflare just serves the files in ./landing
  "name": "wishperai",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./landing",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
